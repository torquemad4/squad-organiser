{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squad-organiser",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "public" },
  "routes": [{ "pattern": "squads.torquemada.uk", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squad-organiser",
      "database_id": "1d5f75c8-5200-40ec-a9c1-96253ecc916c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Tactics and Theatrics",
    "SMTP_HOST": "smtp.purelymail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "squads@purelymail.com",
    // "smtp" sends real email through Purelymail (needs the SMTP_PASS secret).
    // "dev" writes emails to the dev_outbox table instead; set it in .dev.vars for local work.
    "EMAIL_MODE": "smtp"
  }
  // Secrets (wrangler secret put ...):
  //   SMTP_PASS       password for SMTP_USER
  //   ADMIN_EMAILS    comma-separated emails with admin rights; the first is the initial captain
}
